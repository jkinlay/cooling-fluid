      "set": {"outcome_rules": {"OTHER": "arbitrary"}},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["missing_outcome_rules"]
    },
    {
      "id": "NEGATIVE_CONSUMED_HOURS",
      "input_scenario": "Synthetic copy with negative consumed research hours",
