  "parser_regressions": [
    {
      "id": "NEGATIVE_RAW_CONTROL_DUPLICATE_PUBLICATION_POLICY",
      "input_scenario": "Raw control JSON duplicates publication policy with an earlier PUBLISHED value",
      "raw": "{\"publication_policy_status\":\"PUBLISHED\",\"publication_policy_status\":\"UNDECIDED_CANDIDATE_LEVEL_PUBLICATION_BLOCKED\"}",
      "expected_error": "duplicate JSON object key: publication_policy_status"
    },
    {
      "id": "NEGATIVE_RAW_CASES_DUPLICATE_CASES",
      "input_scenario": "Raw cases JSON duplicates the cases key",
      "raw": "{\"cases\":[],\"cases\":[]}",
      "expected_error": "duplicate JSON object key: cases"
    },
    {
      "id": "NEGATIVE_RAW_CONTROL_NAN",
      "input_scenario": "Raw control JSON uses a nonfinite NaN consumed-hours constant",
      "raw": "{\"actual_research_hours\":NaN}",
      "expected_error": "non-finite JSON constant: NaN"
    }
  ]
}
