      "as_of_date": "2026-10-01",
      "evidence_terms_set": {"public_desk_only": 1},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["acceptance_scope_mismatch"]
    },
    {
      "id": "NEGATIVE_COORDINATED_DEADLINE_TAMPER",
      "input_scenario": "Synthetic copy coordinating a later deadline in the record and mutable acceptance terms",
      "as_of_date": "2026-10-01",
      "set": {"accepted_review_deadline": "2026-10-15"},
      "evidence_terms_set": {"review_deadline": "2026-10-15"},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["acceptance_scope_mismatch"]
    },
    {
      "id": "NEGATIVE_COORDINATED_OWNER_TOTAL_TAMPER",
      "input_scenario": "Synthetic copy coordinating a higher owner-review total in the record and mutable acceptance terms",
