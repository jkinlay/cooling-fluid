      "set": {"actual_research_hours": -1},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["invalid_consumed_hours"]
    },
    {
      "id": "NEGATIVE_NONFINITE_CONSUMED_HOURS",
      "input_scenario": "Synthetic in-memory copy with nonfinite consumed research hours",
      "as_of_date": "2026-10-01",
      "nonfinite_set": {"actual_research_hours": "NaN"},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["invalid_consumed_hours"]
    },
    {
      "id": "BOUNDARY_PRIOR_CAP_NO_STOP",
      "input_scenario": "Synthetic copy at the superseded initial 40-hour cap within the amended 120-hour limit",
      "as_of_date": "2026-10-01",
      "set": {"actual_research_hours": 40},
      "expected": "PUBLIC_DESK_ONLY",
      "expected_reasons": ["within_accepted_date_and_hour_caps"]
    },
    {
      "id": "BOUNDARY_HOUR_CAP",
      "input_scenario": "Historical synthetic copy at the first amended 120-hour cap before the 1000-hour decision",
      "as_of_date": "2026-10-01",
      "set": {"actual_research_hours": 120, "decisive_evidence_status": "UNRESOLVED"},
      "expected": "STOP_PENDING_OWNER_DECISION",
      "expected_reasons": ["research_hour_cap_reached", "decisive_evidence_unresolved"]
    },
    {
      "id": "POSITIVE_SECOND_AMENDMENT_EFFECTIVE",
      "input_scenario": "Owner-accepted control after the retained 1000-hour amendment, with the recorded 67.2 research hours",
      "as_of_date": "2026-10-02",
      "expected": "PUBLIC_DESK_ONLY",
      "expected_reasons": ["within_accepted_date_and_hour_caps"]
    },
    {
      "id": "BOUNDARY_SECOND_AMENDMENT_HOUR_CAP",
      "input_scenario": "Synthetic copy at exactly 1000 shared research hours after the second owner amendment",
      "as_of_date": "2026-10-02",
      "set": {"actual_research_hours": 1000, "decisive_evidence_status": "UNRESOLVED"},
      "expected": "STOP_PENDING_OWNER_DECISION",
      "expected_reasons": ["research_hour_cap_reached", "decisive_evidence_unresolved"]
    },
    {
      "id": "BOUNDARY_LAST_ACCEPTED_DAY",
      "input_scenario": "Synthetic copy on 14 October, the last accepted working day, below the shared hour cap",
      "as_of_date": "2026-10-14",
      "set": {"actual_research_hours": 119},
      "expected": "PUBLIC_DESK_ONLY",
      "expected_reasons": ["within_accepted_date_and_hour_caps"]
    },
    {
      "id": "BOUNDARY_AFTER_DEADLINE",
      "input_scenario": "Synthetic copy immediately after the accepted final day with unresolved decisive evidence",
      "as_of_date": "2026-10-15",
      "set": {"decisive_evidence_status": "UNRESOLVED"},
      "expected": "STOP_PENDING_OWNER_DECISION",
      "expected_reasons": ["accepted_deadline_passed", "decisive_evidence_unresolved"]
    }
