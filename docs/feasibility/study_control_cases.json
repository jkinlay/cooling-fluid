{
  "record_type": "FDE-FEAS-001 synthetic control-case inputs",
  "version": "1.7",
  "base_control": "docs/feasibility/study_control.json",
  "cases": [
    {
      "id": "POSITIVE",
      "input_scenario": "Owner-accepted control on the accepted start date with zero consumed research hours",
      "as_of_date": "2026-10-01",
      "set": {"actual_research_hours": 0},
      "expected": "PUBLIC_DESK_ONLY",
      "expected_reasons": ["within_accepted_date_and_hour_caps"]
    },
    {
      "id": "NEGATIVE_MISSING_OWNER",
      "input_scenario": "Synthetic copy with the owner field removed",
      "as_of_date": "2026-10-01",
      "remove": ["owner_account"],
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["missing_owner"]
    },
    {
      "id": "NEGATIVE_NULL_DEADLINE",
      "input_scenario": "Synthetic copy with null accepted deadline",
      "as_of_date": "2026-10-01",
      "set": {"accepted_review_deadline": null},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["missing_or_invalid_accepted_review_deadline"]
    },
    {
      "id": "NEGATIVE_MISSING_SPEND",
      "input_scenario": "Synthetic copy with accepted external spend cap removed",
      "as_of_date": "2026-10-01",
      "remove": ["accepted_external_spend_cap_gbp"],
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["missing_or_invalid_spend_cap"]
    },
    {
      "id": "NEGATIVE_UNACCEPTED_STATUS",
      "input_scenario": "Synthetic copy with PROPOSED_NOT_STARTED status",
      "as_of_date": "2026-10-01",
      "set": {"status": "PROPOSED_NOT_STARTED"},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["status_not_accepted"]
    },
    {
      "id": "NEGATIVE_UNRELATED_ACCEPTANCE",
