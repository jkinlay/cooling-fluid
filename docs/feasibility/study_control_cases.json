      "expected_reasons": ["immutable_control_mismatch"]
    },
    {
      "id": "NEGATIVE_RUNTIME_SPEND_MUTATION",
      "input_scenario": "Synthetic copy authorizing a runtime spike in spend",
      "as_of_date": "2026-10-02",
      "set": {"runtime_spike_spend_cap": 1},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["immutable_control_mismatch"]
    },
    {
      "id": "NEGATIVE_LABORATORY_PARTNER_MUTATION",
      "input_scenario": "Synthetic copy naming a laboratory partner",
      "as_of_date": "2026-10-02",
      "set": {"laboratory_partner": "Example Lab"},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["immutable_control_mismatch"]
    },
    {
      "id": "NEGATIVE_UNALLOWED_TOP_LEVEL_KEY",
      "input_scenario": "Synthetic copy adding an unapproved publication authorization key",
      "as_of_date": "2026-10-02",
      "set": {"publication_authorized": true},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["immutable_control_mismatch"]
    },
    {
      "id": "NEGATIVE_SECOND_AMENDMENT_SCOPE_TAMPERED",
      "input_scenario": "Synthetic copy with the retained 1000-hour amendment scope changed",
      "as_of_date": "2026-10-02",
      "amendment_index": 1,
      "amendment_set": {"scope": "Different scope"},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["acceptance_scope_mismatch"]
    },
    {
      "id": "NEGATIVE_INVALID_ACCEPTANCE_DATE",
      "input_scenario": "Synthetic copy with an invalid acceptance date",
      "as_of_date": "2026-10-01",
      "evidence_set": {"date": "not-a-date"},
      "expected": "PROPOSED_NOT_STARTED",
      "expected_reasons": ["invalid_acceptance_date"]
    },
    {
      "id": "NEGATIVE_ARBITRARY_OUTCOMES",
      "input_scenario": "Synthetic copy without STOP_DOMAIN, INCONCLUSIVE or CONTINUE definitions",
